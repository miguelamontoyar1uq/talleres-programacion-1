<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="583.0" prefWidth="721.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.empresajfx.viewController.ProductoViewController">
    <children>
        <Label alignment="CENTER" layoutX="268.0" layoutY="14.0" text="Gestión de Productos">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="40.0" layoutY="70.0" text="Código:" />
        <TextField fx:id="txtCodigo" layoutX="154.0" layoutY="64.0" prefHeight="39.0" prefWidth="472.0" />

        <Label layoutX="40.0" layoutY="110.0" text="Nombre:" />
        <TextField fx:id="txtNombreProducto" layoutX="154.0" layoutY="104.0" prefHeight="39.0" prefWidth="472.0" />

        <Label layoutX="40.0" layoutY="150.0" text="Cantidad:" />
        <TextField fx:id="txtCantidad" layoutX="154.0" layoutY="144.0" prefHeight="39.0" prefWidth="472.0" />

        <Button fx:id="btbAgregarProducto" layoutX="185.0" layoutY="236.0" onAction="#onAgregarProducto" text="Agregar Producto" />
        <Button fx:id="btnActualizarProducto" layoutX="365.0" layoutY="236.0" onAction="#onActualizarProducto" text="Actualizar Producto" />

        <TableView fx:id="tblListProductos" layoutX="40.0" layoutY="292.0" prefHeight="223.0" prefWidth="638.0">
            <columns>
                <TableColumn fx:id="tbcCodigo" prefWidth="81.0" text="Código" />
                <TableColumn fx:id="tbcNombreProducto" prefWidth="287.0" text="Nombre Producto" />
                <TableColumn fx:id="tbcCantidad" prefWidth="126.0" text="Cantidad" />
            <TableColumn fx:id="tbcProveedor" prefWidth="143.0" text="Proveedor" />
            </columns>
        </TableView>

        <Button fx:id="btnLimpiar" layoutX="268.0" layoutY="530.0" onAction="#onLimpiar" text="Limpiar" />
        <Button fx:id="btnEliminar" layoutX="365.0" layoutY="530.0" onAction="#onEliminar" text="Eliminar" />
      <TextField fx:id="txtProveedor" layoutX="154.0" layoutY="185.0" prefHeight="39.0" prefWidth="472.0" />
      <Label layoutX="40.0" layoutY="191.0" text="Proveedor:" />
    </children>
</AnchorPane>
